# 环境变量模板：复制为 .env 后填入你自己的真实值，不要把 .env 提交到仓库
# .env 会被 .gitignore 忽略；本文件（.env.example）不含任何真实密钥，可安全提交

# 模型（通义千问 / DashScope）：对话模型与嵌入模型都通过它鉴权
DASHSCOPE_API_KEY=your-dashscope-api-key

# 数据库连接串（PostgreSQL），config_handler 与 store 都优先读它
DATABASE_URL=postgresql://用户名:密码@127.0.0.1:5432/数据库名

# 管理员注册邀请码：真实值只放在这里，config/admin.yml 里保持为空
ADMIN_INVITE_CODE=change-me

# FastAPI 登录态签名 cookie 用的密钥（随机长字符串；换掉会让所有已登录会话失效）
SESSION_SECRET=please-generate-a-random-secret

# 以下为可选：当前代码默认走 DashScope，如需切换到其它 OpenAI 兼容网关再取消注释
# DEEPSEEK_API_KEY=your-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# CLOSEAI_API_KEY=your-key
# CLOSEAI_BASE_URL=https://openrouter.ai/api/v1
# SILICONFLOW_API_KEY=your-key
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
