# 环境变量模板：复制为 .env 后填入你自己的真实值，不要把 .env 提交到仓库
# .env 会被 .gitignore 忽略；本文件（.env.example）不含任何真实密钥，可安全提交

# 模型（SiliconFlow / 硅基流动）：对话模型与嵌入模型都通过它鉴权
SILICONFLOW_API_KEY=your-siliconflow-api-key
# 可选，代码里默认就是下面这个地址；换用其它兼容端点时再取消注释
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 数据库（PostgreSQL，通过 docker compose 启动）：
# 下面三项给容器自己用，必须与 DATABASE_URL 中的用户名/密码/库名一致
POSTGRES_USER=agent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agent

# 数据库连接串（PostgreSQL），config_handler 与 store 都优先读它
# 走 docker compose 时填：postgresql://agent:你在上面设置的密码@127.0.0.1:5432/agent
DATABASE_URL=postgresql://用户名:密码@127.0.0.1:5432/数据库名
# 应用容器内部连接串；用户名、密码、库名需与上方 POSTGRES_* 一致
DATABASE_URL_DOCKER=postgresql://agent:change-me@postgres:5432/agent

# 管理员注册邀请码：真实值只放在这里，config/admin.yml 里保持为空
ADMIN_INVITE_CODE=change-me

# FastAPI 登录态签名 cookie 用的密钥（随机长字符串；换掉会让所有已登录会话失效）
SESSION_SECRET=please-generate-a-random-secret

# 以下为可选：当前代码默认走 SiliconFlow。
# 如需改用其它 OpenAI 兼容网关，除了填密钥，还要同步修改 智能体/model/factory.py 里的 base_url 与 api_key。
# DASHSCOPE_API_KEY=your-dashscope-api-key
# DEEPSEEK_API_KEY=your-key
# CLOSEAI_API_KEY=your-key
